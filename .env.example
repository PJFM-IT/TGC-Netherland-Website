# Formspree form ID (the part after https://formspree.io/f/).
# Leave empty to fall back to a mailto: link using the email in src/content/settings/site.json.
PUBLIC_FORMSPREE_ID=

# Admin (/admin): the password for the church admin, at least 8 characters.
# Changing it logs everyone out.
ADMIN_PASSWORD=

# Where the admin's meetings, videos and uploads are saved:
# - On Vercel: connect a *public* Blob store to the project; Vercel sets BLOB_READ_WRITE_TOKEN itself.
# - On your own server / locally: files in DATA_DIR (default ./data). Back this folder up.
# BLOB_READ_WRITE_TOKEN=
# DATA_DIR=./data
