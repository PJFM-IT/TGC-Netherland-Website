---
import type { HighlightView } from '../lib/content';
import Icon from './Icon.astro';
import PhoneFrame from './PhoneFrame.astro';
import HighlightVideo from './HighlightVideo.astro';
import { formatLongDate, localizePath, useTranslations, type Lang } from '../i18n/utils';

/**
 * A fixed phone mockup in the centre with the highlights sliding through it (Swiper coverflow).
 * The phone sits behind the carousel; the active card lines up with the phone's screen.
 * The date at the top of the phone follows the active slide (src/scripts/carousels.ts).
 */
interface Props {
  lang: Lang;
  entries: HighlightView[];
}

const { lang, entries } = Astro.props;
const t = useTranslations(lang);
const initial = Math.floor((entries.length - 1) / 2);
const start = entries[initial];
---

<section class="hl" aria-label={t('a11y.highlightsCarousel')} aria-roledescription={t('a11y.carousel')}>
  <div class="hl__stage">
    <div class="hl__phone">
    <PhoneFrame>
      <div class="hl__phone-top" aria-hidden="true">
        <p class="hl__date-label">{t('community.dateLabel')}</p>
        <p class="hl__date" data-phone-date>{start && formatLongDate(start.data.date, lang)}</p>
      </div>
      <div class="hl__phone-window"></div>
      <div class="hl__phone-bottom">
        <a class="btn hl__view-all" href={localizePath('/community-life/all', lang)}>{t('community.viewAll')}</a>
      </div>
    </PhoneFrame>
    </div>

    <div class="swiper hl__swiper" data-highlights-carousel data-initial={initial}>
      <div class="swiper-wrapper">
        {
          entries.map((entry, index) => {
            const { title, speaker, date, youtubeId, thumbnail } = entry.data;
            const dateLabel = formatLongDate(date, lang);
            return (
              <div class:list={['swiper-slide', 'hl__slide', index === initial && 'hl__slide--start']} data-date-label={dateLabel}>
                <article class="hl-card">
                  <HighlightVideo youtubeId={youtubeId} thumbnail={thumbnail} title={title} playLabel={t('a11y.play')} portrait />
                  <div class="hl-card__text">
                    <h2 class="hl-card__title">{title}</h2>
                    <p class="hl-card__speaker">{speaker}</p>
                    <p class="visually-hidden">
                      {t('community.dateLabel')}: <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
                    </p>
                  </div>
                </article>
              </div>
            );
          })
        }
      </div>
    </div>

    {/* Visible only when focused with the keyboard; mouse and touch users click or swipe the cards. */}
    <button class="carousel-btn hl__nav hl__nav--prev" type="button" data-prev aria-label={t('a11y.prev')}><Icon name="arrow-left" /></button>
    <button class="carousel-btn hl__nav hl__nav--next" type="button" data-next aria-label={t('a11y.next')}><Icon name="arrow-right" /></button>
  </div>
</section>

<script>
  import '../scripts/videos';
  import { initHighlightsCarousels } from '../scripts/carousels';
  initHighlightsCarousels();
</script>

<style>
  .hl {
    /* Phone and card sizes; everything else is derived from these. */
    --phone-w: min(310px, 74vw);
    --bezel: 10px;
    --screen-pad: 12px;
    --top-h: 92px;
    --bottom-h: 78px;
    --card-w: calc(var(--phone-w) - 2 * var(--bezel) - 2 * var(--screen-pad));
    --card-h: calc(var(--card-w) * 1.6);
    --phone-h: calc(var(--card-h) + var(--top-h) + var(--bottom-h) + 2 * var(--bezel));
    --swiper-pad: 40px;

    overflow: hidden;
    padding-block: var(--space-2xl);
    background: linear-gradient(to bottom, var(--color-white), #f1f1f2 70%, #e9e9ea);
  }

  .hl__stage {
    position: relative;
    height: var(--phone-h);
  }

  .hl__phone {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 0;
    translate: -50% 0;
  }

  .hl__phone-top {
    display: grid;
    align-content: end;
    height: var(--top-h);
    padding-bottom: 10px;
    text-align: center;
  }

  .hl__date-label {
    color: var(--color-ink);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.3;
  }

  .hl__date {
    color: var(--color-ink);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.2;
  }

  .hl__phone-window {
    flex: 0 0 var(--card-h);
  }

  .hl__phone-bottom {
    display: grid;
    flex: 1;
    align-items: center;
    padding-inline: var(--screen-pad);
  }

  .hl__view-all {
    position: relative;
    z-index: 2;
    width: 100%;
    --btn-border: #b9b9bd;
    font-weight: 500;
  }

  /* The carousel lies over the phone; its slides are exactly the size of the phone's screen window. */
  .hl__swiper {
    position: absolute;
    top: calc(var(--bezel) + var(--top-h) - var(--swiper-pad));
    left: 0;
    right: 0;
    z-index: 1;
    height: calc(var(--card-h) + 2 * var(--swiper-pad));
    padding-block: var(--swiper-pad);
    overflow: visible;
  }

  .hl__slide {
    width: var(--card-w);
    height: var(--card-h);
  }

  .hl__slide:not(.swiper-slide-active) {
    cursor: pointer;
  }

  .hl__slide:not(.swiper-slide-active) :global(lite-youtube) {
    pointer-events: none;
  }

  /* Before Swiper runs: show just the centre card in the phone. */
  .hl__swiper:not(.swiper-initialized) .swiper-wrapper {
    justify-content: center;
  }

  .hl__swiper:not(.swiper-initialized) .hl__slide:not(.hl__slide--start) {
    display: none;
  }

  .hl-card {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 22px;
    background: #cfd8dc;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.16);
  }

  .hl-card :global(lite-youtube.video--portrait) {
    position: absolute;
    inset: 0;
    height: 100%;
    border-radius: 0;
  }

  .hl-card :global(lite-youtube.video--portrait)::after {
    padding-bottom: 0;
  }

  .hl-card :global(lite-youtube.video--portrait > .lyt-playbtn)::before {
    width: 46px;
    height: 46px;
    background-size: 22px;
  }

  .hl-card__text {
    position: absolute;
    inset: 0 0 auto;
    padding: 1.5rem 1rem 3rem;
    background: linear-gradient(to bottom, rgba(10, 30, 40, 0.55), rgba(10, 30, 40, 0));
    color: var(--color-white);
    text-align: center;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease);
  }

  .hl-card:has(lite-youtube.lyt-activated) .hl-card__text {
    opacity: 0;
  }

  .hl-card__title {
    font-size: var(--fs-base);
    font-weight: 500;
    letter-spacing: 0;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  }

  .hl-card__speaker {
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--fs-xs);
  }

  /* Keyboard-only arrows */
  .hl__nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    translate: 0 -50%;
  }

  .hl__nav--prev {
    left: var(--gutter);
  }

  .hl__nav--next {
    right: var(--gutter);
  }

  .hl__nav:not(:focus-visible) {
    clip-path: inset(50%);
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .hl {
      --top-h: 100px;
      --bottom-h: 84px;
    }

    .hl__date {
      font-size: var(--fs-lg);
    }
  }
</style>
