---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Card split in two: text + action on the left, image on the right (stacked on mobile). */
interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { title, image, imageAlt } = Astro.props;
---

<article class="card split-card">
  <div class="split-card__text">
    <h2>{title}</h2>
    <slot />
  </div>
  <div class="split-card__media">
    <Image src={image} alt={imageAlt} widths={[400, 640, 800]} sizes="(min-width: 768px) 550px, 100vw" />
  </div>
</article>

<style>
  .split-card {
    display: grid;
  }

  .split-card__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-xl) var(--space-lg);
  }

  .split-card__text h2 {
    font-size: var(--fs-md);
  }

  .split-card__text :global(p) {
    color: var(--color-ink);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  /* Button sits at the bottom-left of the card */
  .split-card__text :global(.btn) {
    margin-top: auto;
  }

  .split-card__media {
    order: -1;
  }

  .split-card__media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .split-card {
      grid-template-columns: 1fr 1fr;
      min-height: 440px;
    }

    .split-card__text {
      padding: var(--space-2xl) var(--space-xl) var(--space-xl);
    }

    .split-card__text :global(p) {
      max-width: 42ch;
    }

    .split-card__text h2 {
      font-size: var(--fs-lg);
    }

    .split-card__media {
      order: 0;
    }

    .split-card__media img {
      aspect-ratio: auto;
    }
  }
</style>
