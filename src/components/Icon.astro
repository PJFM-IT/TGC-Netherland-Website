  phone:
    '<path d="M5 3.5h3.2l1.6 4.3-2.1 1.4a11.5 11.5 0 0 0 7.1 7.1l1.4-2.1 4.3 1.6V19a1.8 1.8 0 0 1-1.9 1.8A16.8 16.8 0 0 1 3.2 5.4 1.8 1.8 0 0 1 5 3.5Z"/>',
  'heart-phone':
    '<path d="M5 3.5h3.2l1.6 4.3-2.1 1.4a11.5 11.5 0 0 0 7.1 7.1l1.4-2.1 4.3 1.6V19a1.8 1.8 0 0 1-1.9 1.8A16.8 16.8 0 0 1 3.2 5.4 1.8 1.8 0 0 1 5 3.5Z"/><path d="M17 3.4c-.8-.9-2.3-.6-2.6.6-.3 1.1.9 2.1 2.6 3.2 1.7-1.1 2.9-2.1 2.6-3.2-.3-1.2-1.8-1.5-2.6-.6Z"/>',
  calendar: '<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  video: '<rect x="2.5" y="6" width="13" height="12" rx="2"/><path d="m15.5 10.5 6-3.5v10l-6-3.5"/>',
  facebook:
    '<path d="M14 8.5V7c0-.8.5-1 1-1h1.8V3H14c-2.6 0-3.5 1.8-3.5 3.8v1.7H8.5V12h2v9h3.5v-9h2.5l.4-3.5Z" fill="currentColor" stroke="none"/>',
  linkedin:
    '<path d="M4 9h3.5v11H4zM5.8 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM10 9h3.3v1.6c.5-.9 1.7-1.9 3.5-1.9 3.6 0 4.2 2.3 4.2 5.4V20h-3.5v-5.2c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V20H10Z" fill="currentColor" stroke="none"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>',
  'mail-solid':
    '<path d="M3.5 5h17A1.5 1.5 0 0 1 22 6.5v.3l-10 6.4L2 6.8v-.3A1.5 1.5 0 0 1 3.5 5Z" fill="currentColor" stroke="none"/><path d="M2 8.9v8.6A1.5 1.5 0 0 0 3.5 19h17a1.5 1.5 0 0 0 1.5-1.5V8.9l-9.5 6.1a1 1 0 0 1-1 0Z" fill="currentColor" stroke="none"/>',
