---
/** Inline SVG icons (stroke icons inherit currentColor). Decorative unless `label` is given. */
export type IconName =
  | 'arrow-right'
  | 'arrow-left'
  | 'arrow-up-right'
  | 'mail'
  | 'phone'
  | 'heart-phone'
  | 'calendar'
  | 'clock'
  | 'video'
  | 'facebook'
  | 'linkedin'
  | 'instagram'
  | 'youtube'
  | 'mail-solid'
  | 'phone-waves'
  | 'headset';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-left': '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
