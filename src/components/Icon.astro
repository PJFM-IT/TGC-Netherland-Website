  headset:
    '<path d="M4 13v-1a8 8 0 0 1 16 0v1" stroke-width="1.8"/><rect x="3" y="12.5" width="4" height="6.5" rx="1.6" fill="currentColor" stroke="none"/><rect x="17" y="12.5" width="4" height="6.5" rx="1.6" fill="currentColor" stroke="none"/><path d="M19 19c0 1.6-1.6 2.5-4 2.5h-1.5" stroke-width="1.6"/><rect x="11" y="20.3" width="3.5" height="2.4" rx="1.2" fill="currentColor" stroke="none"/>',
