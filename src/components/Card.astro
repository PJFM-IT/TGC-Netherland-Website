---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

/** White card with an image on top, a heading, text and a single text link. */
interface Props {
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  linkLabel: string;
  href: string;
  external?: boolean;
  newTabLabel?: string;
  headingLevel?: 'h2' | 'h3';
  /** CSS object-position for the cropped image, e.g. "50% 20%" to keep a face in frame. */
  imagePosition?: string;
}

const { image, imageAlt, title, linkLabel, href, external = false, newTabLabel = '', headingLevel = 'h2', imagePosition } = Astro.props;
const Heading = headingLevel;
---

<article class="card info-card">
  <Image src={image} alt={imageAlt} widths={[400, 640, 800]} sizes="(min-width: 768px) 540px, 100vw" class="info-card__img" style={imagePosition ? `object-position: ${imagePosition}` : undefined} />
  <div class="card__body info-card__body">
    <Heading class="info-card__title">{title}</Heading>
    <p><slot /></p>
    <a class="text-link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
      {linkLabel}
      {external && <span class="visually-hidden"> {newTabLabel}</span>}
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</article>

<style>
  .info-card {
    display: flex;
    flex-direction: column;
  }

  .info-card__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .info-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-md);
  }

  .info-card__body .text-link {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
